{
  "manifest_version": 3,
  "name": "Preview & Shorts Controls for YouTube",
  "version": "0.6.0",
  "description": "Inline video previews, preview volume and seeking, and optional Shorts information hiding for YouTube.",
  "minimum_chrome_version": "111",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "visibility-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "audio-guard.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "settings-bridge.js",
        "volume-controller.js",
        "clear-view.js"
      ],
      "css": [
        "volume-controls.css",
        "clear-view.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "visibility-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "author": "Lenged",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Preview & Shorts Controls for YouTube \u00b7 Settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
